<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Self-hosted servers often use a private CA, so user-installed certificates are trusted
         alongside the system ones (#27). Cleartext is permitted here only because this file
         can't name address ranges: NextcloudClient refuses plain HTTP to anything outside the
         local network before a request is sent. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
